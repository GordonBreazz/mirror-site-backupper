# ═══════════════════════════════════════════════════════════════
# Скопируйте этот файл в credentials.conf и заполните реальными
# данными. credentials.conf НЕ должен коммититься в git —
# он уже добавлен в .gitignore.
# ═══════════════════════════════════════════════════════════════

# --- Подключение к удалённому серверу ---
REMOTE_USER=""      # например: backupper
REMOTE_HOST=""      # домен или IP сервера
REMOTE_PORT="22"

# Корневая папка на удалённом сервере, где лежат папки ВСЕХ сайтов
# хостинг-аккаунта. rsync заберёт её целиком одним вызовом.
# Дампы БД скрипт сам сложит в подпапку внутри неё
# (см. NAME_REMOTE_DUMP_DIR в backup_script.sh) —
# указывать отдельный путь под дампы не нужно.
REMOTE_ROOT_DIR=""  # например: /var/www

# --- Локальная папка для бэкапов (необязательно) ---
# По умолчанию — $HOME/backup (домашняя папка пользователя, от которого
# запущен скрипт). Раскомментируйте, только если нужен другой путь
# (например, отдельный смонтированный диск под бэкапы).
# LOCAL_DIR_PATH="/mnt/backups"

# --- Приватный SSH-ключ (необязательно) ---
# Если не задано — скрипт сам найдёт единственный ключ в ~/.ssh
# (id_ed25519 / id_rsa / id_ecdsa / id_ed25519_sk). Укажите явно,
# только если ключей несколько или используется нестандартное имя.
# SSH_KEY_PATH="/home/user/.ssh/id_ed25519"

# --- Базы данных ---
# Формат: ["имя_базы"]="пользователь_бд:пароль_бд"
# Можно перечислить сколько угодно баз — все дампятся одним
# SSH-сеансом за один прогон.
declare -A DATABASES=(
    ["имя_базы1"]="пользователь1:пароль1"
    # ["имя_базы2"]="пользователь2:пароль2"
)
